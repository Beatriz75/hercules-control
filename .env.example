# Copiar a .env y completar. No subir .env al repositorio.

# Versión a desplegar: etiqueta de las imágenes Docker (igual a la etiqueta de Git, p. ej. v1.0.0)
APP_VERSION=v1.0.0

# Base de datos
POSTGRES_DB=hercules_control
POSTGRES_USER=hercules
POSTGRES_PASSWORD=cambia-esta-clave

# Seguridad: clave aleatoria de 32+ caracteres.
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
ENVIRONMENT=production
# Duración de la sesión en minutos (480 = 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primer administrador: se crea solo si la tabla de usuarios está vacía.
# Después del primer arranque se puede borrar INITIAL_ADMIN_PASSWORD de este archivo.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Administrador

# Puerto donde se publica la app (el HTTPS va delante, ver docs/DEPLOY.md)
WEB_PORT=8080

# Archivos subidos (videos e imágenes de los cursos): tamaño máximo por archivo en MB.
# Se guardan en el volumen Docker media_data (ver docs/DEPLOY.md para respaldarlo).
# Si se sube por encima de 600 MB, aumentar también client_max_body_size en deploy/nginx.conf.
MAX_UPLOAD_MB=500

# Solo si la app web se sirve desde otro dominio distinto al de la API (normalmente vacío)
ALLOWED_ORIGINS=
